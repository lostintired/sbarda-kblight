<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>KbLight</Product>
    <Description>Подсветка клавиатуры sbarda</Description>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="KbLight.app.ico" />
  </ItemGroup>

  <!-- -p:NoBuiltinModels=true builds a test exe that knows no keyboard (manual check of Unsupported). -->
  <ItemGroup Condition="'$(NoBuiltinModels)' != 'true'">
    <EmbeddedResource Include="models\*.json" LogicalName="KbLight.models.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
